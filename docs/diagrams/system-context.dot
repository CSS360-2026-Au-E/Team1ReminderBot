digraph Context {
 graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.8", ranksep="1.4", splines=polyline, fontname="Arial", labelloc=t, label="Team1ReminderBot — System Context Diagram", fontsize=24];
 node [shape=box, style="rounded,filled", fontname="Arial", fontsize=15, margin="0.25,0.20", color="#42734b", fillcolor="#dcf5dc", penwidth=1.5];
 edge [fontname="Arial", fontsize=11, color="#526171", fontcolor="#334155", arrowsize=0.8, penwidth=1.4];
 member [label="Discord Member\nStudy group participant"];
 discord [label="Discord Platform\nClient, Gateway, and API"];
 subgraph cluster_bot {
 label="System boundary"; fontname="Arial"; fontsize=14; color="#94a3b8"; style="rounded,dashed"; margin=25;
 bot [shape=ellipse, fillcolor="#d5f1fa", color="#25718c", label="Team1ReminderBot\nProcesses commands\nSchedules reminders\nPrepares notifications"];
 }
 member -> discord [label="Slash commands and reminder details\nServer joins"];
 discord -> member [label="Command replies\nReminder DMs and welcome messages"];
 discord -> bot [label="Command interactions\nMember join events and user IDs"];
 bot -> discord [label="Command registration and replies\nReminder DMs and welcome messages"];
}